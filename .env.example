# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL Database Connections
# Pooled connection string (with -pooler suffix) used for application queries
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string used for Prisma schema migrations
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="iota_academy_jwt_access_secret_sample_key_min32chars"
JWT_REFRESH_SECRET="iota_academy_jwt_refresh_secret_sample_key_min32chars"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Meta WhatsApp Cloud API (Optional in local dev, mock fallback enabled)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# SMTP Transactional Email (Optional in local dev, console fallback enabled)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="IOTA Academy <noreply@iotaacademy.in>"

# File Storage Configuration (local | s3 | r2)
FILE_STORAGE_PROVIDER="local"
FILE_STORAGE_BUCKET=""
FILE_STORAGE_ACCESS_KEY=""
FILE_STORAGE_SECRET_KEY=""
UPLOAD_DIR="./uploads"

