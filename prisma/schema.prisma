datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum Role {
  ADMIN
  COUNSELLOR
  SALES
  PARTNER
}

enum PartnerCategory {
  COMPUTER_CENTER
  COACHING_INSTITUTE
  LIBRARY
  HOSTEL
  EDUCATIONAL_INSTITUTE
  BOOKSTORE_OR_CAFE
  OTHER
}

enum PartnerStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
  INACTIVE
}

enum PremisesStatus {
  UNASSIGNED
  ASSIGNED
  VISITED
  PARTNER_ONBOARDED
  NOT_INTERESTED
  INVALID_PREMISES
}

enum VisitStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  INTERESTED
  NOT_INTERESTED
  FOLLOW_UP_REQUIRED
  PARTNER_ONBOARDED
  INVALID_CONTACT
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONNECTED
  INTERESTED
  NOT_INTERESTED
  FOLLOW_UP_REQUIRED
  OFFICE_VISIT_SCHEDULED
  OFFICE_VISIT_COMPLETED
  DEMO_ATTENDED
  ADMISSION_CONFIRMED
  LOST
  INVALID_CONTACT
  DUPLICATE_IGNORED
}

enum LeadSource {
  PARTNER_QR
  PARTNER_LINK
  DIRECT_WALK_IN
  WEBSITE_ORGANIC
  FIELD_SALES
}

enum LeadActivityType {
  STATUS_CHANGE
  NOTE_ADDED
  PHONE_CALL
  WHATSAPP_MESSAGE
  OFFICE_VISIT_SCHEDULED
  DEMO_SCHEDULED
  COUNSELLOR_ASSIGNED
  COUNSELLOR_REASSIGNED
  ADMISSION_CLOSED
  SYSTEM_ATTRIBUTED
}

enum AdmissionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  CANCELLED
  REFUNDED
}

enum CommissionStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  PAID
  ON_HOLD
  REVERSED
}

enum SettlementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  FAILED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// -------------------------------------------------------------
// Models
// -------------------------------------------------------------

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  passwordHash    String       @map("password_hash")
  fullName        String       @map("full_name")
  phone           String       @unique
  role            Role         @default(SALES)
  isActive        Boolean      @default(true) @map("is_active")
  avatarUrl       String?      @map("avatar_url")
  lastLoginAt     DateTime?    @map("last_login_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  partnerProfile     Partner?
  refreshTokens      RefreshToken[]
  assignedVisits     PremisesVisit[]    @relation("SalesVisits")
  leadAssignments    LeadAssignment[]   @relation("CounsellorAssignments")
  leadActivities     LeadActivity[]
  notifications      Notification[]
  ticketsCreated     SupportTicket[]    @relation("TicketCreator")
  ticketsAssigned    SupportTicket[]    @relation("TicketAssignee")
  auditLogs          AuditLog[]

  @@index([role, isActive])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  isRevoked   Boolean   @default(false) @map("is_revoked")
  replacedBy  String?   @map("replaced_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}

model Partner {
  id                  String           @id @default(uuid())
  userId              String           @unique @map("user_id")
  partnerCode         String           @unique @map("partner_code")
  businessName        String           @map("business_name")
  category            PartnerCategory  @default(COMPUTER_CENTER)
  ownerName           String           @map("owner_name")
  contactPerson       String?          @map("contact_person")
  mobile              String           @map("mobile")
  whatsapp            String?          @map("whatsapp")
  email               String           @map("email")
  addressLine1        String           @map("address_line1")
  addressLine2        String?          @map("address_line2")
  city                String           @map("city")
  area                String           @map("area")
  pincode             String           @map("pincode")
  latitude            Float?
  longitude           Float?
  qrCodeUrl           String?          @map("qr_code_url")
  registrationUrl     String           @map("registration_url")
  status              PartnerStatus    @default(PENDING_APPROVAL)
  rejectionReason     String?          @map("rejection_reason")
  bankAccountName     String?          @map("bank_account_name")
  bankAccountNumber   String?          @map("bank_account_number")
  bankIfsc            String?          @map("bank_ifsc")
  bankName            String?          @map("bank_name")
  upiId               String?          @map("upi_id")
  onboardedByUserId   String?          @map("onboarded_by_user_id")
  premisesId          String?          @unique @map("premises_id")
  approvedAt          DateTime?        @map("approved_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  user                User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  premises            Premises?        @relation(fields: [premisesId], references: [id], onDelete: SetNull)
  documents           PartnerDocument[]
  leads               Lead[]
  commissions         PartnerCommission[]
  settlements         Settlement[]
  supportTickets      SupportTicket[]

  @@index([status, city])
  @@index([partnerCode])
  @@map("partners")
}

model PartnerDocument {
  id            String    @id @default(uuid())
  partnerId     String    @map("partner_id")
  documentType  String    @map("document_type")
  fileUrl       String    @map("file_url")
  originalName  String    @map("original_name")
  mimeType      String    @map("mime_type")
  fileSize      Int       @map("file_size")
  isVerified    Boolean   @default(false) @map("is_verified")
  createdAt     DateTime  @default(now()) @map("created_at")

  partner       Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_documents")
}

model Premises {
  id                  String           @id @default(uuid())
  premisesName        String           @map("premises_name")
  category            PartnerCategory  @default(COMPUTER_CENTER)
  ownerName           String           @map("owner_name")
  contactPerson       String?          @map("contact_person")
  mobile              String           @map("mobile")
  altMobile           String?          @map("alt_mobile")
  addressLine1        String           @map("address_line1")
  addressLine2        String?          @map("address_line2")
  city                String           @map("city")
  area                String           @map("area")
  pincode             String           @map("pincode")
  latitude            Float?
  longitude           Float?
  currentStatus       PremisesStatus   @default(UNASSIGNED) @map("current_status")
  assignedSalesId     String?          @map("assigned_sales_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  partner             Partner?
  visits              PremisesVisit[]

  @@index([city, area, currentStatus])
  @@index([assignedSalesId])
  @@map("premises")
}

model PremisesVisit {
  id                  String       @id @default(uuid())
  premisesId          String       @map("premises_id")
  salespersonId       String       @map("salesperson_id")
  status              VisitStatus  @default(ASSIGNED)
  assignedAt          DateTime     @default(now()) @map("assigned_at")
  scheduledDate       DateTime?    @map("scheduled_date")
  visitedAt           DateTime?    @map("visited_at")
  checkinLatitude     Float?       @map("checkin_latitude")
  checkinLongitude    Float?       @map("checkin_longitude")
  distanceFromTarget  Float?       @map("distance_from_target")
  remarks             String?
  photoUrl            String?      @map("photo_url")
  idempotencyKey      String?      @unique @map("idempotency_key")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  premises            Premises     @relation(fields: [premisesId], references: [id], onDelete: Restrict)
  salesperson         User         @relation("SalesVisits", fields: [salespersonId], references: [id], onDelete: Restrict)

  @@index([salespersonId, status])
  @@index([premisesId, status])
  @@map("premises_visits")
}

model Course {
  id              String            @id @default(uuid())
  code            String            @unique
  name            String
  description     String?
  feeAmount       Decimal           @map("fee_amount") @db.Decimal(12, 2)
  durationWeeks   Int               @default(12) @map("duration_weeks")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  leads           Lead[]
  admissions      Admission[]
  commissionRules CommissionRule[]

  @@map("courses")
}

model Lead {
  id                   String           @id @default(uuid())
  leadCode             String           @unique @map("lead_code")
  partnerId            String?          @map("partner_id")
  interestedCourseId   String?          @map("interested_course_id")
  source               LeadSource       @default(PARTNER_QR)
  studentName          String           @map("student_name")
  mobile               String           @map("mobile")
  whatsapp             String?          @map("whatsapp")
  currentEducation     String?          @map("current_education")
  city                 String           @map("city")
  area                 String?          @map("area")
  preferredContactTime String?          @map("preferred_contact_time")
  communicationConsent Boolean          @default(true) @map("communication_consent")
  status               LeadStatus       @default(NEW)
  currentCounsellorId  String?          @map("current_counsellor_id")
  lastActivityAt       DateTime?        @map("last_activity_at")
  lastActivityById     String?          @map("last_activity_by_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  partner              Partner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  interestedCourse     Course?          @relation(fields: [interestedCourseId], references: [id], onDelete: SetNull)
  activities           LeadActivity[]
  assignments          LeadAssignment[]
  duplicateSubmissions DuplicateLeadSubmission[]
  admission            Admission?

  @@index([mobile])
  @@index([partnerId, status])
  @@index([currentCounsellorId, status])
  @@index([status, createdAt])
  @@map("leads")
}

model DuplicateLeadSubmission {
  id               String       @id @default(uuid())
  originalLeadId   String       @map("original_lead_id")
  attemptedPartnerId String?    @map("attempted_partner_id")
  submittedName    String       @map("submitted_name")
  submittedMobile  String       @map("submitted_mobile")
  rawPayload       Json         @map("raw_payload")
  reason           String
  createdAt        DateTime     @default(now()) @map("created_at")

  originalLead     Lead         @relation(fields: [originalLeadId], references: [id], onDelete: Cascade)

  @@index([originalLeadId])
  @@map("duplicate_lead_submissions")
}

model LeadAssignment {
  id              String       @id @default(uuid())
  leadId          String       @map("lead_id")
  counsellorId    String       @map("counsellor_id")
  assignedByUserId String?     @map("assigned_by_user_id")
  isCurrent       Boolean      @default(true) @map("is_current")
  assignedAt      DateTime     @default(now()) @map("assigned_at")
  unassignedAt    DateTime?    @map("unassigned_at")

  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counsellor      User         @relation("CounsellorAssignments", fields: [counsellorId], references: [id], onDelete: Restrict)

  @@index([leadId, isCurrent])
  @@index([counsellorId, isCurrent])
  @@map("lead_assignments")
}

model LeadActivity {
  id              String            @id @default(uuid())
  leadId          String            @map("lead_id")
  userId          String            @map("user_id")
  activityType    LeadActivityType  @map("activity_type")
  previousStatus  LeadStatus?       @map("previous_status")
  newStatus       LeadStatus?       @map("new_status")
  remarks         String?
  scheduledFor    DateTime?         @map("scheduled_for")
  createdAt       DateTime          @default(now()) @map("created_at")

  lead            Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([userId, activityType])
  @@map("lead_activities")
}

model Admission {
  id                 String           @id @default(uuid())
  admissionCode      String           @unique @map("admission_code")
  leadId             String           @unique @map("lead_id")
  courseId           String           @map("course_id")
  totalFee           Decimal          @map("total_fee") @db.Decimal(12, 2)
  paidFee            Decimal          @map("paid_fee") @db.Decimal(12, 2)
  admissionDate      DateTime         @default(now()) @map("admission_date")
  status             AdmissionStatus  @default(PENDING_VERIFICATION)
  verifiedByUserId   String?          @map("verified_by_user_id")
  verifiedAt         DateTime?        @map("verified_at")
  rejectionReason    String?          @map("rejection_reason")
  refundDate         DateTime?        @map("refund_date")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  lead               Lead             @relation(fields: [leadId], references: [id], onDelete: Restrict)
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payments           AdmissionPayment[]
  commission         PartnerCommission?

  @@index([status, admissionDate])
  @@map("admissions")
}

model AdmissionPayment {
  id               String       @id @default(uuid())
  admissionId      String       @map("admission_id")
  amount           Decimal      @db.Decimal(12, 2)
  paymentMode      String       @map("payment_mode")
  referenceNumber  String?      @map("reference_number")
  paymentDate      DateTime     @default(now()) @map("payment_date")
  receiptUrl       String?      @map("receipt_url")
  createdAt        DateTime     @default(now()) @map("created_at")

  admission        Admission    @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@map("admission_payments")
}

model CommissionRule {
  id              String       @id @default(uuid())
  courseId        String?      @map("course_id")
  ruleName        String       @map("rule_name")
  commissionType  String       @default("FLAT") @map("commission_type")
  commissionValue Decimal      @map("commission_value") @db.Decimal(12, 2)
  effectiveFrom   DateTime     @default(now()) @map("effective_from")
  effectiveTo     DateTime?    @map("effective_to")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")

  course          Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  commissions     PartnerCommission[]

  @@map("commission_rules")
}

model PartnerCommission {
  id                 String           @id @default(uuid())
  partnerId          String           @map("partner_id")
  admissionId        String           @unique @map("admission_id")
  commissionRuleId   String?          @map("commission_rule_id")
  commissionAmount   Decimal          @map("commission_amount") @db.Decimal(12, 2)
  status             CommissionStatus @default(PENDING)
  settlementId       String?          @map("settlement_id")
  reversalReason     String?          @map("reversal_reason")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  partner            Partner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  admission          Admission        @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  commissionRule     CommissionRule?  @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  settlement         Settlement?      @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([partnerId, status])
  @@index([settlementId])
  @@map("partner_commissions")
}

model Settlement {
  id                  String             @id @default(uuid())
  settlementCode      String             @unique @map("settlement_code")
  partnerId           String             @map("partner_id")
  totalAmount         Decimal            @map("total_amount") @db.Decimal(12, 2)
  adjustmentAmount    Decimal            @default(0.00) @map("adjustment_amount") @db.Decimal(12, 2)
  netPaidAmount       Decimal            @map("net_paid_amount") @db.Decimal(12, 2)
  status              SettlementStatus   @default(DRAFT)
  periodStartDate     DateTime           @map("period_start_date")
  periodEndDate       DateTime           @map("period_end_date")
  approvedByUserId    String?            @map("approved_by_user_id")
  approvedAt          DateTime?          @map("approved_at")
  paidAt              DateTime?          @map("paid_at")
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  partner             Partner            @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  commissions         PartnerCommission[]
  transactions        SettlementTransaction[]

  @@index([partnerId, status])
  @@index([status, createdAt])
  @@map("settlements")
}

model SettlementTransaction {
  id                String       @id @default(uuid())
  settlementId      String       @map("settlement_id")
  amount            Decimal      @db.Decimal(12, 2)
  paymentMode       String       @default("NEFT") @map("payment_mode")
  transactionRef    String       @map("transaction_ref")
  paymentProofUrl   String?      @map("payment_proof_url")
  transactedAt      DateTime     @default(now()) @map("transacted_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  settlement        Settlement   @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("settlement_transactions")
}

model Notification {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  title        String
  message      String
  channel      NotificationChannel @default(IN_APP)
  status       NotificationStatus  @default(PENDING)
  actionUrl    String?             @map("action_url")
  metadata     Json?
  readAt       DateTime?           @map("read_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, readAt])
  @@map("notifications")
}

model SupportTicket {
  id               String          @id @default(uuid())
  ticketCode       String          @unique @map("ticket_code")
  partnerId        String          @map("partner_id")
  createdById      String          @map("created_by_id")
  assignedToId     String?         @map("assigned_to_id")
  subject          String
  description      String
  priority         TicketPriority  @default(MEDIUM)
  status           TicketStatus    @default(OPEN)
  resolvedAt       DateTime?       @map("resolved_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  partner          Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  creator          User            @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee         User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([partnerId, status])
  @@map("support_tickets")
}

model AuditLog {
  id           String     @id @default(uuid())
  userId       String?    @map("user_id")
  action       String
  entityType   String     @map("entity_type")
  entityId     String     @map("entity_id")
  ipAddress    String?    @map("ip_address")
  userAgent    String?    @map("user_agent")
  oldValues    Json?      @map("old_values")
  newValues    Json?      @map("new_values")
  createdAt    DateTime   @default(now()) @map("created_at")

  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

